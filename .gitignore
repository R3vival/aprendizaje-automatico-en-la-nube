# =============================================================================
# .gitignore — Aprendizaje Automático en la Nube
# =============================================================================
# La regla de oro: ignoramos ARTEFACTOS (lo que se puede regenerar), nunca
# CONFIGURACION (lo que define como se regenera).
# Las reglas se escriben con la ruta mas especifica posible para no excluir
# silenciosamente archivos importantes (por ejemplo, metadata.json).
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
MANIFEST

# --- Entornos virtuales ---
.venv/
venv/
ENV/
env/
.python-version.local

# --- Testing y cobertura ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/
.tox/

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- Secretos (NUNCA commitear) ---
.env
.env.*
!.env.example
*.pem
*.key
credentials
.aws/
.secrets/

# --- Datos (se descargan con `make data`, se verifican por hash) ---
data/raw/*
!data/raw/metadata.json
data/processed/
data/interim/
data/external/
*.parquet
*.csv
*.feather
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.parquet

# --- Modelos y artefactos (se obtienen del registry: models:/<name>@champion)
models/
# ...pero `src/BeijingAir/models/` es un PAQUETE de codigo, no una carpeta de
# artefactos. Sin esta negacion, la regla `models/` lo excluiria entero.
!src/BeijingAir/models/
# La regla amplia `models/` tampoco debe ocultar las pruebas del paquete.
!tests/models/
!tests/models/**

# Los bytecode temporales no se versionan, tampoco dentro de tests/models.
tests/models/__pycache__/
artifacts/
*.pkl
*.joblib
*.ubj
*.bin
!*.b
mlruns/
mlartifacts/
# Backend SQLite de las trazas de la sesion 8 (LLMOPS_TRACING=local)
mlruns-llmops.db
reports/llmops/
mlflow.db
*.db-journal
outputs/
reports/*.html
# ...pero el reporte de drift SI va al repo: es la evidencia que pide la
# rubrica de monitoreo. Los demas HTML de reports/ siguen ignorados.
!reports/drift-report.html
reports/*.json
!reports/.gitkeep

# --- Prefect ---
.prefect/
prefect.db

# --- Evidently ---
evidently_workspace/
drift_report*.html

# --- IDE / OS ---
# `.vscode/*` y no `.vscode/`: una regla que excluye el DIRECTORIO no admite
# negaciones de archivos dentro de el (git no entra a un directorio excluido).
# Es el mismo bug que tenia `models/` con src/taxi/models/.
.vscode/*
# ...pero settings.json y extensions.json SI van al repositorio.
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Agentes de codigo ---
.claude/

# --- Terraform (si se agrega IaC) ---
.terraform/
*.tfstate
*.tfstate.*

# =============================================================================
# EXCEPCIONES EXPLICITAS
# Estos archivos SI van al repo aunque coincidan con patrones de arriba.
# =============================================================================
!**/metadata.json          # procedencia y checksums de datasets y modelos
!**/dataset-metadata.json
!.pre-commit-config.yaml
!.github/**/*.yml
!.github/**/*.yaml
!docker-compose.yml
!Dockerfile
!**/Dockerfile

# --- Configuracion local de herramientas de IA ---
# .mcp.json guarda tokens en claro (GITHUB_PERSONAL_ACCESS_TOKEN). Es config de
# la maquina de cada quien, no del repositorio.
.mcp.json
.claude/settings.local.json

# --- Transferencia de ramas (temporales) ---
*.bundle
limpiar-y-finalizar.sh
